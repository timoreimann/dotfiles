{{- $taps := get . "taps" | default (list) -}}
{{- $brews := get . "brews" | default (list) -}}
{{- $casks := get . "casks" | default (list) -}}
# Prefer brew-auth (1Password-backed GitHub token) when available so taps and
# installs do not hit unauthenticated GitHub API rate limits. Check
# ~/bin/brew-auth directly as well because ~/bin may not be on PATH yet in a
# fresh bootstrap shell.
brew_cmd="brew"
if command -v op >/dev/null 2>&1; then
  if command -v brew-auth >/dev/null 2>&1; then
    brew_cmd="brew-auth"
  elif [[ -x "${HOME}/bin/brew-auth" ]]; then
    brew_cmd="${HOME}/bin/brew-auth"
  fi
fi

# Font casks install into ~/Library/Fonts by default. A wiped home directory
# then loses the fonts, but Homebrew still records them as installed and
# brew bundle skips them. /Library/Fonts is outside the home directory.
readonly FONTDIR="/Library/Fonts"

"${brew_cmd}" bundle --file=/dev/stdin <<EOF
cask_args fontdir: "${FONTDIR}"
{{ range $taps -}}
tap {{ . | quote }}
{{ end -}}
{{ range $brews -}}
brew {{ . | quote }}
{{ end -}}
{{ range $casks -}}
cask {{ . | quote }}
{{ end -}}
EOF
{{- if $casks }}

# Print the installed casks that have a font outside FONTDIR or a missing
# font. This happens after a wiped home directory, or for casks that were
# installed before the font directory changed. brew bundle skips them.
misplaced_font_casks() {
  "${brew_cmd}" info --cask --json=v2{{ range $casks }} {{ . | quote }}{{ end }} \
    | jq -r '.casks[] | select(.installed != null) | .token as $token
        | .artifacts[] | select(has("font")) | [$token, .target] | @tsv' \
    | while IFS=$'\t' read -r cask target; do
        if [[ "${target}" != "${FONTDIR}/"* || ! -e "${target}" ]]; then
          echo "${cask}"
        fi
      done \
    | sort -u
}

casks="$(misplaced_font_casks)"
if [[ -n "${casks}" ]]; then
  # Cask names contain no spaces, so word splitting is safe.
  # shellcheck disable=SC2086
  "${brew_cmd}" reinstall --cask --fontdir="${FONTDIR}" ${casks}
fi
{{- end }}