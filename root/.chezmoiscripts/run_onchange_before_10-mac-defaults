#!/usr/bin/env bash

set -o errexit
set -o nounset
set -o pipefail

### Appearance
# Always show scroll bar
defaults write -g AppleShowScrollBars -string Always
# Click in the scroll bar to jump to the spot that's clicked
defaults write -g AppleScrollerPagingBehavior -int 1

### Control Centre
# Show Bluetooth in control centre
defaults write com.apple.controlcenter 'NSStatusItem Visible Bluetooth' -int 1
# Show Battery in control centre
defaults write com.apple.controlcenter 'NSStatusItem Visible Battery' -int 1
# Show Battery percentage
defaults write com.apple.menuextra.battery ShowPercent -string YES

# Date: show always
defaults write com.apple.menuextra.clock ShowDate -int 1
# Date: show the day of the week
defaults write com.apple.menuextra.clock ShowDayOfWeek -int 1
# Date: digital style
defaults write com.apple.menuextra.clock IsAnalog -int 0
# Date: use the 24-hour clock
defaults write com.apple.menuextra.clock Show24Hour -int 1
# Date: display the time with seconds
defaults write com.apple.menuextra.clock ShowSeconds -int 1

### Desktop & Dock
# Do not show recent applications in Dock
defaults write com.apple.dock 'show-recents' -int 0
# Set bottom-left corner to 'Application Windows'
defaults write com.apple.dock wvous-bl-corner -int 3
# Do not automatically rearrange Spaces based on most recent use
defaults write com.apple.dock mru-spaces -int 0
# Displays should not have separate Spaces
defaults write com.apple.dock spans-displays -int 1

### Trackpad
# Tap to click (built-in and Bluetooth trackpads)
defaults write com.apple.AppleMultitouchTrackpad Clicking -int 1
defaults write com.apple.driver.AppleBluetoothMultitouch.trackpad Clicking -int 1
defaults -currentHost write -g com.apple.mouse.tapBehavior -int 1
defaults write -g com.apple.mouse.tapBehavior -int 1
# Secondary click with two-finger click or tap (disable corner click)
defaults write com.apple.AppleMultitouchTrackpad TrackpadRightClick -bool true
defaults write com.apple.AppleMultitouchTrackpad TrackpadCornerSecondaryClick -int 0
defaults write com.apple.driver.AppleBluetoothMultitouch.trackpad TrackpadRightClick -bool true
defaults write com.apple.driver.AppleBluetoothMultitouch.trackpad TrackpadCornerSecondaryClick -int 0
defaults -currentHost write -g com.apple.trackpad.enableSecondaryClick -bool true
# Disable natural scrolling
defaults write -g com.apple.swipescrolldirection -bool false
# Swipe between pages with two or three fingers
defaults write -g AppleEnableSwipeNavigateWithScrolls -bool true
defaults write com.apple.AppleMultitouchTrackpad TrackpadThreeFingerHorizSwipeGesture -int 1
defaults write com.apple.driver.AppleBluetoothMultitouch.trackpad TrackpadThreeFingerHorizSwipeGesture -int 1
defaults -currentHost write -g com.apple.trackpad.threeFingerHorizSwipeGesture -int 1
# Swipe between full-screen applications: off
defaults write com.apple.driver.AppleBluetoothMultitouch.trackpad TrackpadFourFingerHorizSwipeGesture -int 0
# Swipe for notification centre: off
defaults write com.apple.driver.AppleBluetoothMultitouch.trackpad TrackpadTwoFingerFromRightEdgeSwipeGesture -int 0
# Swipe down with three fingers for App Expose
defaults write com.apple.driver.AppleBluetoothMultitouch.trackpad TrackpadThreeFingerVertSwipeGesture -int 2
# Disable Launchpad and Show Desktop
defaults write com.apple.driver.AppleBluetoothMultitouch.trackpad TrackpadFiveFingerPinchGesture -int 0
defaults write com.apple.driver.AppleBluetoothMultitouch.trackpad TrackpadFourFingerPinchGesture -int 0
# Disable force click to ease drag & drop
defaults write com.apple.AppleMultitouchTrackpad ForceSuppressed -bool true

### Keyboard
# Use Fn keys as standard function keys
defaults write -g com.apple.keyboard.fnState -int 1
# Set a macOS symbolic hotkey using XML plist types so activateSettings loads it.
# Arguments: hotkey id, enabled (true|false), char code, key code, modifier flags.
symbolic_hotkey() {
    defaults write com.apple.symbolichotkeys AppleSymbolicHotKeys -dict-add "$1" \
        "<dict><key>enabled</key><$2/><key>value</key><dict><key>parameters</key><array><integer>$3</integer><integer>$4</integer><integer>$5</integer></array><key>type</key><string>standard</string></dict></dict>"
}

# Switch to Desktop N via Control+N
symbolic_hotkey 118 true 65535 18 262144
symbolic_hotkey 119 true 65535 19 262144
# Disable shortcuts for switching input sources
symbolic_hotkey 60 false 32 49 262144
symbolic_hotkey 61 false 32 49 786432

# Disable a macOS Services entry in both context and Services menus.
disable_service() {
    defaults write pbs NSServicesStatus -dict-add "$1" \
        "<dict><key>enabled_context_menu</key><false/><key>enabled_services_menu</key><false/><key>presentation_modes</key><dict><key>ContextMenu</key><false/><key>ServicesMenu</key><false/></dict></dict>"
}
disable_service "com.apple.Terminal - Search man Page Index in Terminal - searchManPages"
disable_service "com.apple.Terminal - Open man Page in Terminal - openManPage"

### Menu bar icons
# Always show battery percentage
defaults write com.apple.controlcenter "NSStatusItem Visible Item-5" -int 0
# Always show bluetooth icon
defaults write com.apple.controlcenter "NSStatusItem Preferred Position Bluetooth" -int 359
# Do not show Input menu (for some reason, the option maps to two settings)
defaults write com.apple.TextInputMenu visible -int 0
defaults write com.apple.TextInputMenuAgent "NSStatusItem Visible Item-0" -int 0

### .DS_Store handling
# Disable copying to network drives
defaults write com.apple.desktopservices DSDontWriteNetworkStores -bool TRUE
# Disable copying to USB drives
defaults write com.apple.desktopservices DSDontWriteUSBStores -bool TRUE

### Clipy
# Max clipboard history size
defaults write com.clipy-app.Clipy kCPYPrefMaxHistorySizeKey -int 150
# Number of iteams place inline
defaults write com.clipy-app.Clipy kCPYPrefNumberOfItemsPlaceInlineKey -int 30
# Clipy hotkeys. Clipy stores each one as JSON text in a data value: "null"
# means no hotkey. In "modifiers", cmd is 256 and ctrl is 4096. Keep
# cmd+shift+v free for "Paste and Match Style" in apps.
# Main menu: none (default: cmd+shift+v).
defaults write com.clipy-app.Clipy mainKeyCombo -data 6e756c6c
# History menu: cmd+ctrl+v (the default). Write it explicitly, so that every
# machine gets the same value.
# {"modifiers":4352,"key":"v","doubledModifiers":false}
defaults write com.clipy-app.Clipy historyKeyCombo -data 7b226d6f64696669657273223a343335322c226b6579223a2276222c22646f75626c65644d6f64696669657273223a66616c73657d

### Rectangle
# Skip the welcome dialog that asks for the default shortcut set
defaults write com.knollsoft.Rectangle wasWelcomeDisplayed -bool true
# Use the Spectacle shortcut set as fallback for actions not set below
defaults write com.knollsoft.Rectangle alternateDefaultShortcuts -bool false
# Repeated actions cycle the window size like Spectacle (0 = resize)
defaults write com.knollsoft.Rectangle subsequentExecutionMode -int 0
defaults write com.knollsoft.Rectangle launchOnLogin -bool true

# Set a shortcut for a Rectangle action.
# Arguments: action name, macOS virtual key code, modifier flags.
# Modifier flags are the sum of cmd (1048576), alt (524288),
# ctrl (262144), and shift (131072).
rectangle_shortcut() {
    defaults write com.knollsoft.Rectangle "$1" -dict keyCode -int "$2" modifierFlags -int "$3"
}
rectangle_shortcut maximize 3 1572864           # alt+cmd+f
rectangle_shortcut center 8 1572864             # alt+cmd+c
rectangle_shortcut larger 124 917504            # ctrl+alt+shift+right
rectangle_shortcut smaller 123 917504           # ctrl+alt+shift+left
rectangle_shortcut topLeft 123 1310720          # ctrl+cmd+left
rectangle_shortcut topRight 124 1310720         # ctrl+cmd+right
rectangle_shortcut previousDisplay 123 1835008  # ctrl+alt+cmd+left
rectangle_shortcut nextDisplay 124 1835008      # ctrl+alt+cmd+right
# Repeated presses cycle through the thirds
rectangle_shortcut firstThird 123 786432        # ctrl+alt+left
rectangle_shortcut lastThird 124 786432         # ctrl+alt+right

# Disable fallback shortcuts that block app shortcuts (e.g., alt+cmd+left/right
# for tab switching). An empty dictionary means "no shortcut".
for action in leftHalf rightHalf topHalf bottomHalf bottomLeft bottomRight; do
    defaults write com.knollsoft.Rectangle "${action}" -dict
done

### Reload settings
# Apply trackpad, keyboard, symbolic hotkey, and scroll direction changes
/System/Library/PrivateFrameworks/SystemAdministration.framework/Resources/activateSettings -u
# Refresh Services menu cache
/System/Library/CoreServices/pbs -flush
# Restart UI services so Dock, Control Center, and menu bar pick up changes
for process in Dock ControlCenter SystemUIServer TextInputMenuAgent; do
    killall "${process}" 2>/dev/null || true
done
