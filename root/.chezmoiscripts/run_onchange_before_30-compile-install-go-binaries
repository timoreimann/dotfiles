#!/usr/bin/env bash
set -o errexit
set -o nounset
set -o pipefail

# The script runs before chezmoi writes ~/.zshenv, so GOPATH can be unset.
# Without it, go install puts the binaries into ~/go/bin, which is not on PATH.
export GOPATH="${HOME}/dev/go"

go install github.com/gottwald/git-sweep@86af0096c67f46922d1e584b8c4e81b1454a02bf
