{{- /* chezmoi:modify-template */ -}}
{{- /* Global Git ignore file (~/.gitignore, core.excludesFile). Git reads only
       one global ignore file, so derived chezmoi sources also write this file.
       Each source owns one marked section. The base section comes first.
       - .dev.vars and .wrangler/ ignore Cloudflare Workers (wrangler) local
         secrets and state.
       - AGENTS.local.md ignores local-only agent instructions. */ -}}
{{- $content := `.DS_Store
**/debug.test
**/.idea/
**/.ijwb/
**/.vscode/
.envrc
.autoenv.zsh
.autoenv_leave.zsh
node_modules/
.dev.vars
.wrangler/
AGENTS.local.md` -}}
{{- includeTemplate "section" (dict "stdin" .chezmoi.stdin "name" "base" "content" $content "comment" "# %s" "first" true) -}}
