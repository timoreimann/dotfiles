#!/usr/bin/env bash
# Wrapper around omp that adds fuzzy <model>/<thinking> selection as $1.
# Usage:
#   o                         Start omp with default model and thinking
#   o <model>/<thinking> ...  Fuzzily select model and thinking level
#   o <model>/ ...            Fuzzily select model with default thinking
#   o /<thinking> ...         Pick any model interactively with thinking level
#   o / ...                   Pick any model interactively with default thinking
#   o --refresh [...]         Refresh the cached model list before continuing

set -euo pipefail

readonly CACHE_TTL_SEC=3600

main() {
  local force_refresh=0
  if [[ $# -gt 0 && "$1" == "--refresh" ]]; then
    force_refresh=1
    shift
  fi

  if [[ "$force_refresh" -eq 1 ]]; then
    local refreshed_file
    if ! refreshed_file="$(resolve_cache_file)"; then
      printf 'o: cannot refresh cache when PI_CODING_AGENT_DIR is set\n' >&2
      exit 1
    fi
    if ! refresh_models_cache "$refreshed_file"; then
      exit 1
    fi
    if [[ $# -eq 0 ]]; then
      exit 0
    fi
  fi

  if [[ $# -eq 0 ]]; then
    exec omp
  fi

  local first="$1"

  # Pass flags, @file refs, multi-word prompts, and slash-free args straight through.
  if [[ "$first" == -* || "$first" == @* || "$first" == *[[:space:]]* || "$first" != */* ]]; then
    exec omp "$@"
  fi

  local model_query="${first%/*}"
  local thinking_query="${first##*/}"
  shift

  if [[ -n "$thinking_query" ]]; then
    validate_global_thinking "$thinking_query"
  fi

  local selection
  if selection="$(select_model "$model_query" "$force_refresh")"; then
    :
  else
    exit $?
  fi

  local selector allowed_thinking
  IFS=$'\t' read -r _ _ _ _ selector allowed_thinking <<< "$selection"

  if [[ -z "$thinking_query" ]]; then
    exec omp --model "$selector" "$@"
  fi

  local thinking
  if thinking="$(resolve_thinking "$thinking_query" "$allowed_thinking" "$selector")"; then
    :
  else
    exit $?
  fi

  exec omp --model "$selector" --thinking "$thinking" "$@"
}

# Reject impossible thinking queries before fetching the model catalog.
validate_global_thinking() {
  local raw_query="$1"
  local query
  query="$(printf '%s' "$raw_query" | tr '[:upper:]' '[:lower:]')"

  if printf '%s\n' off minimal low medium high xhigh max auto | fzf --filter="$query" >/dev/null; then
    return 0
  fi

  printf 'o: unknown thinking level "%s" (expected: off, minimal, low, medium, high, xhigh, max, auto)\n' \
    "$raw_query" >&2
  return 1
}

# Resolve model_query against configured omp providers using a cached
# `omp models --json` snapshot when fresh, refreshing on miss or expiry.
select_model() {
  local model_query="$1"
  local already_refreshed="$2"

  local cache_file=""
  if cache_file="$(resolve_cache_file)"; then
    :
  else
    cache_file=""
  fi

  local models_file=""
  local temp_file=""
  local used_cache=0

  if [[ -n "$cache_file" ]] && cache_is_fresh "$cache_file"; then
    models_file="$cache_file"
    used_cache=1
  elif [[ -n "$cache_file" ]]; then
    local refresh_rc=0
    if refresh_models_cache "$cache_file"; then
      models_file="$cache_file"
      already_refreshed=1
    else
      refresh_rc=$?
      if [[ "$refresh_rc" -ne 2 ]]; then
        return "$refresh_rc"
      fi
      temp_file="$(mktemp "${TMPDIR:-/tmp}/o-models.XXXXXX")"
      if ! fetch_models_json "$temp_file"; then
        rm -f "$temp_file"
        return 1
      fi
      models_file="$temp_file"
      already_refreshed=1
    fi
  else
    temp_file="$(mktemp "${TMPDIR:-/tmp}/o-models.XXXXXX")"
    if ! fetch_models_json "$temp_file"; then
      rm -f "$temp_file"
      return 1
    fi
    models_file="$temp_file"
    already_refreshed=1
  fi

  local selection rc=0
  if selection="$(match_model_in_file "$model_query" "$models_file" "$used_cache")"; then
    if [[ -n "$temp_file" ]]; then
      rm -f "$temp_file"
    fi
    printf '%s\n' "$selection"
    return 0
  else
    rc=$?
  fi

  if [[ -n "$temp_file" ]]; then
    rm -f "$temp_file"
  fi

  # Retry once with a fresh catalog if a cached lookup missed or failed to parse.
  if [[ "$used_cache" -eq 1 && "$already_refreshed" -eq 0 && "$rc" -ne 130 ]]; then
    if refresh_models_cache "$cache_file"; then
      if selection="$(match_model_in_file "$model_query" "$cache_file" 0)"; then
        printf '%s\n' "$selection"
        return 0
      else
        return $?
      fi
    fi
  fi

  return "$rc"
}

resolve_cache_file() {
  if [[ -n "${PI_CODING_AGENT_DIR:-}" ]]; then
    return 1
  fi

  local cache_root="${XDG_CACHE_HOME:-${HOME}/.cache}/o"
  local profile="${OMP_PROFILE:-${PI_PROFILE:-}}"
  if [[ -n "$profile" ]]; then
    local safe_profile="${profile//[^A-Za-z0-9._-]/_}"
    printf '%s/models-%s.json\n' "$cache_root" "$safe_profile"
  else
    printf '%s/models.json\n' "$cache_root"
  fi
}

cache_is_fresh() {
  local cache_file="$1"
  if [[ ! -s "$cache_file" ]]; then
    return 1
  fi

  local config_root="${PI_CONFIG_DIR:-${HOME}/.omp}"
  local agent_dir="${config_root}/agent"
  local profile="${OMP_PROFILE:-${PI_PROFILE:-}}"
  if [[ -n "$profile" ]]; then
    agent_dir="${config_root}/profiles/${profile}/agent"
  fi

  local cfg
  for cfg in "${agent_dir}/config.yml" "${agent_dir}/models.yml"; do
    if [[ -e "$cfg" && "$cfg" -nt "$cache_file" ]]; then
      return 1
    fi
  done

  local mtime now age
  if ! mtime="$(file_mtime "$cache_file")"; then
    return 1
  fi
  now="$(date +%s)"
  age=$((now - mtime))
  if (( age < 0 || age >= CACHE_TTL_SEC )); then
    return 1
  fi

  return 0
}

file_mtime() {
  local path="$1"
  local mtime
  if mtime="$(stat -f %m "$path" 2>/dev/null)"; then
    printf '%s\n' "$mtime"
    return 0
  fi
  if mtime="$(stat -c %Y "$path" 2>/dev/null)"; then
    printf '%s\n' "$mtime"
    return 0
  fi
  return 1
}

refresh_models_cache() {
  local cache_file="$1"
  local cache_dir
  cache_dir="$(dirname "$cache_file")"

  if ! mkdir -p "$cache_dir" 2>/dev/null; then
    return 2
  fi

  local tmp_file
  if ! tmp_file="$(mktemp "${cache_dir}/models.json.XXXXXX" 2>/dev/null)"; then
    return 2
  fi

  if ! fetch_models_json "$tmp_file"; then
    rm -f "$tmp_file"
    return 1
  fi

  if ! mv -f "$tmp_file" "$cache_file" 2>/dev/null; then
    rm -f "$tmp_file"
    return 2
  fi

  return 0
}

fetch_models_json() {
  local dest_file="$1"
  if ! omp models --json > "$dest_file"; then
    return 1
  fi
  if ! jq -e '.models | type == "array"' "$dest_file" >/dev/null 2>&1; then
    return 1
  fi
  return 0
}

# Exact id/selector match, then unique substring match, then fuzzy match via fzf.
match_model_in_file() {
  local model_query="$1"
  local models_file="$2"
  local quiet_no_match="$3"

  # Format every model as: id, name, display_thinking, provider, selector, allowed_thinking.
  # shellcheck disable=SC2016
  local row_expr='
    (.thinking // []) as $t
    | [
        .id,
        .name,
        (if ($t | length) > 0 then "[" + ($t | join(",")) + "]" else "[-]" end),
        .provider,
        .selector,
        (if ($t | length) > 0 then (["off"] + $t + ["auto"]) else ["off"] end | join(","))
      ]
    | @tsv
  '

  if [[ -n "$model_query" ]]; then
    local direct_match
    if ! direct_match="$(jq -r --arg q "$model_query" "
      (\$q | ascii_downcase) as \$ql
      | ([.models[] | select((.id | ascii_downcase) == \$ql or (.selector | ascii_downcase) == \$ql)]) as \$exact
      | if (\$exact | length) == 1 then
          \$exact[0] | $row_expr
        else
          ([.models[] | select(
            ((.id | ascii_downcase) | contains(\$ql))
            or ((.name | ascii_downcase) | contains(\$ql))
            or ((\$ql | contains(\"/\")) and ((.selector | ascii_downcase) | contains(\$ql)))
          )]) as \$sub
          | if (\$sub | length) == 1 then
              \$sub[0] | $row_expr
            else
              empty
            end
        end
    " "$models_file")"; then
      return 2
    fi

    if [[ -n "$direct_match" ]]; then
      printf '%s\n' "$direct_match"
      return 0
    fi
  fi

  local model_rows
  if ! model_rows="$(jq -r ".models[] | $row_expr" "$models_file")"; then
    return 2
  fi

  if [[ -z "$model_rows" ]]; then
    if [[ "$quiet_no_match" -eq 0 ]]; then
      printf 'o: no models available (run "omp models" to inspect)\n' >&2
    fi
    return 1
  fi

  # Exclude the provider column from fuzzy matching unless the query includes "/".
  local with_nth='1,2,3,4'
  if [[ "$model_query" == */* ]]; then
    with_nth='5,2,3'
  fi

  local selection
  if selection="$(printf '%s\n' "$model_rows" | fzf \
    --delimiter=$'\t' \
    --with-nth="$with_nth" \
    --nth=1,2 \
    --select-1 \
    --exit-0 \
    --height=40% \
    --reverse \
    --prompt='model> ' \
    --query="$model_query")"; then
    printf '%s\n' "$selection"
    return 0
  else
    local rc=$?
    if [[ "$rc" -eq 1 && "$quiet_no_match" -eq 0 ]]; then
      printf 'o: no model matching "%s"\n' "$model_query" >&2
    fi
    return "$rc"
  fi
}

# Match thinking_query against a model's supported thinking levels:
# exact match, then unique prefix, then fuzzy match via fzf.
resolve_thinking() {
  local raw_query="$1"
  local allowed_csv="$2"
  local selector="$3"

  local query
  query="$(printf '%s' "$raw_query" | tr '[:upper:]' '[:lower:]')"

  local -a levels=()
  IFS=',' read -r -a levels <<< "$allowed_csv"

  local level
  for level in "${levels[@]}"; do
    if [[ "$level" == "$query" ]]; then
      printf '%s\n' "$level"
      return 0
    fi
  done

  local -a prefix_matches=()
  for level in "${levels[@]}"; do
    if [[ "$level" == "$query"* ]]; then
      prefix_matches+=("$level")
    fi
  done

  if [[ ${#prefix_matches[@]} -eq 1 ]]; then
    printf '%s\n' "${prefix_matches[0]}"
    return 0
  fi

  local selected
  if selected="$(printf '%s\n' "${levels[@]}" | fzf \
    --select-1 \
    --exit-0 \
    --height=40% \
    --reverse \
    --prompt='thinking> ' \
    --query="$query")"; then
    printf '%s\n' "$selected"
    return 0
  else
    local rc=$?
    if [[ "$rc" -eq 1 ]]; then
      printf 'o: thinking level "%s" is not supported by %s (supported: %s)\n' \
        "$raw_query" "$selector" "${allowed_csv//,/, }" >&2
    fi
    return "$rc"
  fi
}

main "$@"
